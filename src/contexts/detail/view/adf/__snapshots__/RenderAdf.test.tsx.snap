exports[`RenderAdf > taskList > renders a DONE task as a checked checkbox with strikethrough text 1`] = `"<div class="space-y-3"><ul role="list" class="text-foreground/85 ml-1 space-y-1 text-sm"><li class="flex items-start gap-2"><span role="checkbox" aria-checked="true" aria-disabled="true" class="mt-[3px] inline-flex h-3.5 w-3.5 shrink-0 items-center justify-center rounded-sm border border-sky-500 bg-sky-500 text-white"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-3 w-3" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></span><span class="text-foreground/50 line-through">wrote tests</span></li></ul></div>"`;

